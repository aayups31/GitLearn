{
  "manifest_version": 3,
  "name": "GitLearn — Udemy learning companion",
  "version": "0.1.0",
  "description": "Connect your Udemy lessons with your own local code, notes, and Git checkpoints.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:47831/*",
    "https://*.udemy.com/course/*",
    "https://udemy.com/course/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "GitLearn" },
  "content_scripts": [
    {
      "matches": ["https://*.udemy.com/course/*", "https://udemy.com/course/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
